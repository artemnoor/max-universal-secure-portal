# Заполнить только через secret manager/локальный .env; не коммитить значение.
BOT_TOKEN=
NODE_ENV=development
MINI_APP_BOT_USERNAME=
# MAX API endpoint; non-test runtimes require HTTPS and reject embedded credentials.
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_TRANSPORT=polling
# Staging/production: MAX_TRANSPORT=webhook, WEBHOOK_SECRET, DATABASE_URL/REDIS_URL and PII_ENCRYPTION_KEY are mandatory.
# Production additionally requires rediss:// for Redis and verified PostgreSQL TLS.
# Production additionally requires PUBLIC_APP_ORIGINS=https://... and a trusted TLS edge.
WEBHOOK_DOMAIN=bot.example.com
WEBHOOK_PORT=3000
WEBHOOK_PATH=/max/webhook
# Generate a fresh URL-safe secret for staging/production; keep blank only for local polling.
WEBHOOK_SECRET=
APP_PORT=8787
EDGE_PORT=8080
DATA_DIR=./data
PUBLIC_APP_ORIGINS=http://localhost:8787
# Docker Compose only: use non-empty URL-safe secrets; never commit them.
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=
ALLOW_UNVERIFIED_MINIAPP=false
DEV_ALLOW_UNVERIFIED_MINIAPP=false
INIT_DATA_TTL_SECONDS=900
PII_ENCRYPTION_KEY=
ADMIN_USER_IDS=
LOG_LEVEL=info
# Optional HMAC salt for correlatable principalHash values; empty means "unavailable", never a raw user id.
LOG_PRINCIPAL_SALT=
RUN_POSTGRES_INTEGRATION=false
# Set only for an explicitly approved local integration environment; never use this to bypass isolation in CI.
INTEGRATION_USE_EXISTING_SERVICES=false
# Optional local CA bundle used by the development multi-process runner.
NODE_EXTRA_CA_CERTS=
# Release gates: staging/production require the first two values to be true.
# Keep optional capabilities disabled until their provider, data policy and review are approved.
PORTAL_SECURITY_V2=false
PORTAL_STORAGE_V2=false
PORTAL_AI_ENABLED=false

# Необязательно. Любой OpenAI-compatible API для AI-консультанта.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
